# Aucune valeur réelle. Copier vers .env (gitignoré) si une base locale est utilisée.
# Pour le lancement de démonstration, ces variables ne sont pas nécessaires :
#   python outils/demo_fictif.py
DC_EDU_DEMO=1
# Contours de la carte en mode démo. Par défaut : dcdash/geo_demo.json, contours SCHÉMATIQUES approximatifs
# générés hors ligne (outils/generer_geo_demo.py), jamais les limites officielles. Pour une carte officielle,
# indiquer un fichier au même format {"provinces": [{"geometry", "region"}] × 45, "regions": [...] × 13}.
# DC_EDU_DEMO_GEO=/chemin/vers/contours.json
DC_EDU_AUTH=0
DC_EDU_PG_HOST=127.0.0.1
DC_EDU_PG_PORT=5432
DC_EDU_PG_DB=data_challenge_edu
DC_EDU_PG_USER=
DC_EDU_PG_PASSWORD=
DC_EDU_CODE_HASH=
DC_EDU_SECRET_KEY=
